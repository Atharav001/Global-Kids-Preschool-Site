{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "bg", "color": "#FFF8EC", "name": "Background Cream" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Surface White" },
        { "slug": "ink", "color": "#2B2A35", "name": "Ink Charcoal" },
        { "slug": "ink-soft", "color": "#5B596A", "name": "Ink Soft Slate" },
        { "slug": "line", "color": "#EADFC9", "name": "Border Line" },
        { "slug": "sun", "color": "#FFC93C", "name": "Sun Yellow (Primary)" },
        { "slug": "sun-hover", "color": "#F7B500", "name": "Sun Yellow Hover" },
        { "slug": "blue", "color": "#2A62D8", "name": "Trust Blue" },
        { "slug": "coral", "color": "#FF6B4A", "name": "Warm Coral" },
        { "slug": "mint", "color": "#2FA67A", "name": "Fresh Mint" },
        { "slug": "lilac", "color": "#7C5CE0", "name": "Soft Lilac" },
        { "slug": "tint-sky", "color": "#E6F3FF", "name": "Sky Tint" },
        { "slug": "tint-mint", "color": "#E3F6EA", "name": "Mint Tint" },
        { "slug": "tint-blush", "color": "#FFE7DF", "name": "Blush Tint" },
        { "slug": "tint-lilac", "color": "#EEE8FF", "name": "Lilac Tint" },
        { "slug": "tint-sun", "color": "#FFF0BF", "name": "Sun Tint" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Fredoka\", system-ui, -apple-system, sans-serif",
          "name": "Fredoka (Headings)",
          "slug": "head"
        },
        {
          "fontFamily": "\"Nunito\", system-ui, -apple-system, sans-serif",
          "name": "Nunito (Body & UI)",
          "slug": "body"
        }
      ],
      "fontSizes": [
        { "name": "Extra Small", "size": "0.8125rem", "slug": "xs" },
        { "name": "Small", "size": "0.9375rem", "slug": "sm" },
        { "name": "Base", "size": "1.0625rem", "slug": "base" },
        { "name": "Large", "size": "1.25rem", "slug": "lg" },
        { "name": "Extra Large", "size": "clamp(1.5rem, 1.3rem + 1vw, 2rem)", "slug": "xl" },
        { "name": "2X Large", "size": "clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem)", "slug": "2xl" },
        { "name": "3X Large (Hero H1)", "size": "clamp(2.375rem, 1.7rem + 3.2vw, 4rem)", "slug": "3xl" }
      ]
    },
    "spacing": {
      "units": [ "rem", "px" ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--head)",
          "lineHeight": "1.15",
          "fontWeight": "600"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        }
      }
    }
  }
}
