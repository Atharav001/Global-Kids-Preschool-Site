{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "bg", "color": "#F3F5F9", "name": "Background Mist" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Surface White" },
        { "slug": "ink", "color": "#17233D", "name": "Ink Navy" },
        { "slug": "ink-soft", "color": "#56617A", "name": "Ink Soft Slate" },
        { "slug": "line", "color": "#DCE2EC", "name": "Border Line" },
        { "slug": "navy", "color": "#142A5C", "name": "Institutional Navy (Primary)" },
        { "slug": "navy-600", "color": "#1D3A78", "name": "Navy Hover" },
        { "slug": "sun", "color": "#E7A100", "name": "Accent Gold" },
        { "slug": "sun-hover", "color": "#C78B00", "name": "Gold Hover" },
        { "slug": "blue", "color": "#1E4FA3", "name": "Action Blue" },
        { "slug": "coral", "color": "#B23A2E", "name": "Brick Coral" },
        { "slug": "mint", "color": "#1E7A55", "name": "Deep Mint" },
        { "slug": "lilac", "color": "#4B3FA6", "name": "Indigo" },
        { "slug": "tint-sky", "color": "#EAF1FB", "name": "Sky Tint" },
        { "slug": "tint-mint", "color": "#E8F4EE", "name": "Mint Tint" },
        { "slug": "tint-blush", "color": "#FBEDEA", "name": "Blush Tint" },
        { "slug": "tint-lilac", "color": "#EFEDFA", "name": "Lilac Tint" },
        { "slug": "tint-sun", "color": "#FBF2D9", "name": "Gold Tint" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, sans-serif",
          "name": "Plus Jakarta Sans (Headings)",
          "slug": "head"
        },
        {
          "fontFamily": "\"Inter\", system-ui, -apple-system, sans-serif",
          "name": "Inter (Body & UI)",
          "slug": "body"
        }
      ],
      "fontSizes": [
        { "name": "Extra Small", "size": "0.8125rem", "slug": "xs" },
        { "name": "Small", "size": "0.9375rem", "slug": "sm" },
        { "name": "Base", "size": "1.0625rem", "slug": "base" },
        { "name": "Large", "size": "1.25rem", "slug": "lg" },
        { "name": "Extra Large", "size": "clamp(1.5rem, 1.3rem + 1vw, 2rem)", "slug": "xl" },
        { "name": "2X Large", "size": "clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem)", "slug": "2xl" },
        { "name": "3X Large (Hero H1)", "size": "clamp(2.375rem, 1.7rem + 3.2vw, 4rem)", "slug": "3xl" }
      ]
    },
    "spacing": {
      "units": [ "rem", "px" ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--head)",
          "lineHeight": "1.15",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        }
      }
    }
  }
}
