    "playground": "npx @wp-playground/cli start --mount=./wp-content/themes/gk-theme:/wordpress/wp-content/themes/gk-theme --mount=./wp-content/plugins/gk-core:/wordpress/wp-content/plugins/gk-core"
  },
  "keywords": [
